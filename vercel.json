{
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "site",
  "buildCommand": "python3 scripts/build.py",
  "headers": [
    { "source": "/data.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(.*)\\.(css|js|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
